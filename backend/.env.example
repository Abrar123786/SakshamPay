# Copy to .env for local development (never commit .env).
# On Render, set these as environment variables in the service settings instead.

APP_NAME=SakshamPay
# development | test | production
APP_ENV=development
DEBUG=true

# PostgreSQL connection. Any of these forms works; the app normalises it to the psycopg 3 driver:
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Leave empty until the database is set up; /health does not need it.
DATABASE_URL=

# Required when APP_ENV=production (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed browser origin(s) for CORS. Comma-separate several, e.g.
#   http://localhost:5173,https://sakshampay.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Logging: LOG_FORMAT is json (structured, default) or console (readable, local only)
LOG_LEVEL=INFO
LOG_FORMAT=json
