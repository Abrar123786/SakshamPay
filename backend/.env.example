# SakshamPay backend configuration
# ------------------------------------------------------------------------------
# Local development: copy this file to .env  (PowerShell: Copy-Item .env.example .env)
# Production (Render): set these as environment variables in the dashboard instead.
# Never commit .env and never put real credentials in this file.
#
# Leave a line commented out to use the default for the current APP_ENV.
# ------------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME=SakshamPay
# development | test | production
APP_ENV=development
# Default: true in development, false otherwise. Must be false in production.
# DEBUG=true
# All versioned business endpoints live under this prefix.
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ----------------------------------------------------
# Optional in development: leave empty to run without a database.
# Required in production. Accepted forms (normalised to the psycopg 3 driver):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Example for the local database created in the README:
#   DATABASE_URL=postgresql://sakshampay_dev:<your-local-password>@localhost:5432/sakshampay_dev
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=3000
# Logs every SQL statement with parameters. Local debugging only; rejected in production.
DB_ECHO=false

# --- Authentication (used from P-6) -------------------------------------------
# Required in production, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- HTTP ------------------------------------------------------------------------
# Browser origins allowed by CORS: scheme://host[:port], comma-separated, no paths.
# Production accepts https:// origins only, e.g. https://sakshampay.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# Requests with a larger declared body are rejected with 413 (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Logging ---------------------------------------------------------------------
# Defaults: development -> DEBUG + console (readable); test/production -> INFO + json.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
