# SakshamPay backend configuration
# ------------------------------------------------------------------------------
# Local development: copy this file to .env  (PowerShell: Copy-Item .env.example .env)
#   If you already have a .env, do NOT overwrite it: copy only the new lines you need.
# Production (Render): set these as environment variables in the dashboard instead.
# Never commit .env and never put real credentials in this file.
#
# Leave a line commented out to use the default for the current APP_ENV.
# ------------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
APP_NAME=SakshamPay
# development | test | production
APP_ENV=development
# Default: true in development, false otherwise. Must be false in production.
# DEBUG=true
# All versioned business endpoints live under this prefix.
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ----------------------------------------------------
# Optional in development (the app starts without it); required in production.
# Accepted forms (normalised to the psycopg 3 driver):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Local development (database created as described in docs/database-operations.md):
#   DATABASE_URL=postgresql://sakshampay_app:<app-password>@localhost:5432/sakshampay_dev
# Hosted PostgreSQL usually requires TLS; append ?sslmode=require to the URL it gives you.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=3000
# Logs every SQL statement with parameters. Local debugging only; rejected in production.
DB_ECHO=false

# Optional: a DISPOSABLE database for the PostgreSQL test suites. Tests create and
# drop their own temporary schemas, so the development database is safe to use.
# TEST_DATABASE_URL=postgresql://sakshampay_owner:<owner-password>@localhost:5432/sakshampay_dev

# --- Data protection ------------------------------------------------------------
# HMAC key for fingerprints of beneficiary account references, UPI IDs and device IDs.
# Required in production (32+ characters) and for loading seed data. Set it once:
# changing it makes stored fingerprints unmatchable. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IDENTIFIER_HASH_KEY=

# --- Authentication (P-6) ----------------------------------------------------
# Signs access tokens. Needed for login and protected endpoints in EVERY environment
# (there is no fallback key: without it they return 503). At least 32 characters.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out (existing tokens stop verifying).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Account lockout (P-1): this many consecutive wrong passwords lock sign-in for N minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- HTTP ------------------------------------------------------------------------
# Browser origins allowed by CORS: scheme://host[:port], comma-separated, no paths.
# Production accepts https:// origins only, e.g. https://sakshampay.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# Requests with a larger declared body are rejected with 413 (default 1 MiB).
MAX_REQUEST_BODY_BYTES=1048576

# --- Logging ---------------------------------------------------------------------
# Defaults: development -> DEBUG + console (readable); test/production -> INFO + json.
# LOG_LEVEL=INFO
# LOG_FORMAT=json
